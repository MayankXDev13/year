{
  "name": "@year-board/api",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply year-board-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply year-board-db --remote"
  },
  "dependencies": {
    "@year-board/shared": "workspace:*",
    "hono": "^4.7.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250520.0",
    "oxlint": "^1.90.0",
    "typescript": "~5.8.3",
    "wrangler": "^4.16.0"
  }
}
