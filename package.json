{
  "name": "year-board-monorepo",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @year-board/api db:generate",
    "db:migrate:local": "pnpm --filter @year-board/api db:migrate:local",
    "db:migrate:remote": "pnpm --filter @year-board/api db:migrate:remote"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "~5.8.3"
  }
}
